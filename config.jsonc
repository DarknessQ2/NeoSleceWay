{
  "layer": "top",
  "position": "top",
  "margin-left": 10,
  "margin-right": 10,
  "margin-top": 5,
  "height": 48,

  "modules-left": [
    "sway/workspaces",
    "group/controles-musica",
    "custom/musica"   // 👈 ahora está afuera (CLAVE)
  ],
  "modules-center": ["group/apps"],
  "modules-right": [
    "group/red",
    "group/brightness",
    "group/audio",
    "custom/notification",
    "group/reloj-drawer",
    "group/config-drawer"
  ],

  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": ""
    }
  },


  "group/controles-musica": {
    "orientation": "horizontal",
    "modules": [
      "custom/prev",
      "custom/play-pause",
      "custom/next"
    ]
  },

  "custom/prev": {
    "format": "󰒮",
    "on-click": "playerctl previous"
  },
  "custom/play-pause": {
    "format": "󰐊",
    "on-click": "playerctl play-pause"
  },
  "custom/next": {
    "format": "󰒭",
    "on-click": "playerctl next"
  },

  "custom/musica": {
    "exec": "python3 ~/.config/waybar/scripts/memory.py",
    "return-type": "json",
    "format": "{}",
    "escape": true
  },

  "group/apps": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "click-to-reveal": true
    },
    "modules": [
      "custom/app-folder",
      "custom/theme",
      "wlr/taskbar"
    ]
  },

  "custom/app-folder": {
    "format": "  "
  },

  "custom/theme": {
    "format": " 󰒓 ",
    "tooltip": "Cambiar tema Waybar",
    "on-click": "bash -c '[ -x \"$HOME/.config/waybar/scripts/waybar-theme.sh\" ] && \"$HOME/.config/waybar/scripts/waybar-theme.sh\" || true'"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "on-click": "activate"
  },

  "group/red": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "click-to-reveal": true
    },
    "modules": ["network", "network#ssid"]
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 "
  },

  "network#ssid": {
    "format-wifi": "{essid}",
    "format-disconnected": "Sin conexión",
    "on-click": "bash -c '[ -x \"$HOME/.config/waybar/scripts/wifi-menu.sh\" ] && \"$HOME/.config/waybar/scripts/wifi-menu.sh\" || true'"
  },

  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400
    },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-icons": ["", " "],
    "on-click": "pavucontrol"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "group/brightness": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "click-to-reveal": true
    },
    "modules": ["backlight", "backlight/slider"]
  },

  "backlight": {
    "format":   " "
  },

  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "custom/notification": {
    "format": "󰂚",
    "on-click": "swaync-client -t"
  },

  "group/reloj-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "click-to-reveal": true
    },
    "modules": ["clock#time", "clock#date"]
  },

  "group/config-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "click-to-reveal": true
    },
    "modules": [
      "custom/config-icon",
      "custom/power",
      "custom/reboot",
      "custom/suspend",
      "custom/logout"
    ]
  },

  "clock#time": {
    "format": "  {:%H:%M}",
    "tooltip": false
  },
  "clock#date": {
    "format": "󰃭  {:%d/%m}",
    "tooltip": false
  },

  "custom/config-icon": {
    "format":"󰒓",
    "tooltip": false
  },
  "custom/power": {
    "format": "",
    "on-click": "systemctl poweroff",
    "tooltip": false
  },
  "custom/reboot": {
    "format": "󰑐",
    "on-click": "systemctl reboot",
    "tooltip": false
  },
  "custom/suspend": {
    "format": "󰤄",
    "on-click": "systemctl suspend",
    "tooltip": false
  },
  "custom/logout": {
    "format": "󰍃",
    "on-click":"saymsg exit",
    "tooltip": false
  }
}

